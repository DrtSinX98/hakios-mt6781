# HakiOS fragment: the realme 8i (spaced) -- what is true of this phone and of no other with an MT6781.
# Nothing of the phone is on yet (porting step 2: boot with nothing of the phone's). Turn drivers on one at a time,
# only after a run on the phone shows them working.
CONFIG_DEVICE="spaced"
# volume down on the keypad, volume up and power on the PMIC (hakios.mt6781_keys.c)
CONFIG_BUTTONS=3
